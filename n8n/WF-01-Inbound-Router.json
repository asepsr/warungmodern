      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input = $input.first()?.json ?? {};\nconst body = input.body && typeof input.body === 'object' ? input.body : input;\nconst event = body.event;\n\nfunction ignored(reason, extra = {}) {\n  return [{ json: { accepted: false, reason, event: event ?? null, ...extra } }];\n}\n\nif (event !== 'messages.upsert') return ignored('unsupported_event');\n\nconst data = body.data ?? {};\nconst key = data.key ?? {};\nif (key.fromMe === true) return ignored('outgoing_message');\n\nconst remoteJid = typeof key.remoteJid === 'string' ? key.remoteJid : '';\nif (remoteJid.endsWith('@g.us')) return ignored('group_message');\n\nfunction normalizePhone(jid) {\n  if (typeof jid !== 'string' || !jid.includes('@')) return null;\n  const [localPart, domain] = jid.split('@', 2);\n  if (!['s.whatsapp.net', 'c.us'].includes(domain)) return null;\n  let digits = localPart.replace(/\\D/g, '');\n  if (digits.startsWith('00')) digits = digits.slice(2);\n  if (digits.startsWith('0')) digits = `62${digits.slice(1)}`;\n  else if (digits.startsWith('8')) digits = `62${digits}`;\n  if (!digits.startsWith('62') || digits.length < 10 || digits.length > 15) return null;\n  return digits;\n}\n\nlet phone = normalizePhone(remoteJid);\nif (remoteJid.endsWith('@lid')) {\n  phone = normalizePhone(key.remoteJidAlt);\n  if (!phone) return ignored('lid_without_resolvable_phone', { manual_review: true });\n}\nif (!phone) return ignored('unusable_sender_jid', { manual_review: true });\n\nconst message = data.message ?? {};\nconst location = message.locationMessage ?? message.liveLocationMessage ?? null;\nconst image = message.imageMessage ?? null;\nconst mediaBase64 = typeof message.base64 === 'string' ? message.base64 : null;\nconst mediaMimeType = image?.mimetype ?? message.documentMessage?.mimetype ?? null;\nconst mediaFileName = image?.fileName ?? message.documentMessage?.fileName ?? null;\nconst text = message.conversation\n  ?? message.extendedTextMessage?.text\n  ?? image?.caption\n  ?? '';\nconst messageType = String(data.messageType ?? (location ? 'locationMessage' : image ? 'imageMessage' : 'unknown'));\nconst isText = typeof text === 'string' && text.trim().length > 0;\nconst isLocation = Boolean(location);\nconst isImage = Boolean(image);\n\nif (!isText && !isLocation && !isImage) return ignored('unsupported_message_type', { message_type: messageType });\nif (typeof key.id !== 'string' || key.id.length === 0) return ignored('missing_message_id');\n\nconst timestamp = Number(data.messageTimestamp);\nconst payload = {\n  instance: typeof body.instance === 'string' ? body.instance : null,\n  timestamp: Number.isFinite(timestamp) ? timestamp : null,\n  text: isText ? text : null,\n  location: isLocation ? {\n    latitude: location.degreesLatitude ?? null,\n    longitude: location.degreesLongitude ?? null\n  } : null\n};\n\nreturn [{\n  json: {\n    accepted: true,\n    message_id: key.id,\n    phone,\n    message_type: messageType,\n    text: isText ? text : null,\n    is_text: isText,\n    is_location: isLocation,\n    is_image: isImage,\n    media_base64: isImage ? mediaBase64 : null,\n    media_mimetype: isImage ? mediaMimeType : null,\n    media_file_name: isImage ? mediaFileName : null,\n    timestamp: payload.timestamp,\n    instance: payload.instance,\n    location: payload.location,\n    payload\n  }\n}];"
      },
