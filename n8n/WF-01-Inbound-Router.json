    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const inbound = $('Normalize and Filter Inbound').first().json;\nconst response = $input.first()?.json ?? {};\nconst state = response.data?.state ?? 'IDLE';\nlet route;\n\nif (inbound.is_location || state === 'AWAITING_LOCATION') route = 'WF-03';\nelse if (inbound.is_image || state === 'AWAITING_PAYMENT') route = 'WF-05';\nelse if (inbound.is_text && state === 'AWAITING_CONFIRMATION') route = 'WF-04';\nelse if (inbound.is_text) route = 'WF-02';\nelse route = 'WF-07';\n\nreturn [{\n  json: {\n    dispatch_status: 'classified_handler_not_connected',\n    dispatch_target: route,\n    phone: inbound.phone,\n    message_id: inbound.message_id,\n    message_type: inbound.message_type,\n    text: inbound.text,\n    timestamp: inbound.timestamp,\n    instance: inbound.instance,\n                    location: inbound.location,\n    is_text: inbound.is_text,\n    is_location: inbound.is_location,\n    is_image: inbound.is_image,\n    media_base64: inbound.media_base64,\n    media_mimetype: inbound.media_mimetype,\n    media_file_name: inbound.media_file_name,\n    session_state: state,\n    session_context: response.data?.context ?? {}\n  }\n}];"
      },
